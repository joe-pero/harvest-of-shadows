#define WIFI_SSID     "your_network_name_here"
#define WIFI_PASSWORD "your_password_here"

// Every board joins Wi-Fi and ESP-NOW on this one fixed channel. Set your access point(s)
// to the same channel, or boards will fail to find each other.
#define WIFI_CHANNEL  11

// ArduinoOTA password, shared across all show nodes.
#define OTA_PASSWORD  "your_ota_password_here"

// MQTT broker (e.g. Mosquitto) used by the narrators and the show service.
#define MQTT_BROKER_IP   "192.168.1.x"
#define MQTT_BROKER_PORT 1883
#define MQTT_USERNAME    "your_mqtt_username_here"
#define MQTT_PASSWORD    "your_mqtt_password_here"
